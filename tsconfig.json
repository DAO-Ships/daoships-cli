{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "ESNext.Float16", "DOM"], "jsx": "react-jsx", "strict": true,
    "outDir": "dist", "rootDir": "src", "declaration": true,
    "sourceMap": true, "skipLibCheck": false, "noUnusedLocals": true,
    "noUnusedParameters": true, "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
